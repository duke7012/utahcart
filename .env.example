# Server only. Copy to .env.local; never use NEXT_PUBLIC_ for these keys.
SERPAPI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional price-discovery limits.
PRICE_CACHE_TTL_MINUTES=30
PRICE_SEARCH_TIMEOUT_MS=20000
PRICE_MATCH_TIMEOUT_MS=20000

# Optional offline Smith's snapshot importer.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Shared prices (team page + receipt scans for everyone). Vercel → Storage → Upstash Redis sets these two for you.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Passcode for /team (adding and removing shared prices). Pick your own; set it in Vercel.
TEAM_PASSCODE=
